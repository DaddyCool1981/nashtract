  "dependencies": {
    "@nashtract/core": "workspace:*"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.1.6",
    "fast-check": "^3.23.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
