{
  "name": "@nashtract/ledger",
  "version": "0.1.0",
  "private": true,
  "description": "Append-only domain event ledger, deterministic replay, milestone lineage and calibration eligibility for NashTract.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
